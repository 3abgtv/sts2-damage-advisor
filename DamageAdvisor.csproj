<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DamageAdvisor</AssemblyName>
    <RootNamespace>DamageAdvisor</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Slay the Spire 2</GameDir>
    <ManagedDir>$(GameDir)\data_sts2_windows_x86_64</ManagedDir>
  </PropertyGroup>
  <!--
    工坊发布版：dotnet build -p:Workshop=true
    编译期剔除 F9 注入测试牌与卡池转储（源码里是 #if !WORKSHOP），
    所以 DLL 里根本不存在这些能力，affects_gameplay:false 才名副其实。
  -->
  <PropertyGroup Condition="'$(Workshop)' == 'true'">
    <DefineConstants>$(DefineConstants);WORKSHOP</DefineConstants>
    <AssemblyTitle>DamageAdvisor (workshop build)</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(ManagedDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(ManagedDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
